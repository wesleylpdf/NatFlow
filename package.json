{
  "name": "natflow",
  "version": "1.1.0",
  "private": true,
  "description": "NatFlow - controle financeiro de clientes de produtos de beleza e saúde",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "version:pequena": "node scripts/version-bump.js pequena",
    "version:grande": "node scripts/version-bump.js grande",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
